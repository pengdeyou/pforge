# Spell checking makes no sense, spell-checker: disable

include LICENSE.txt
include LICENSE-RUNTIME.txt
include MANIFEST.in
include README.rst
include Changelog.rst
include Developer_Manual.rst
include doc/pforge.1
include doc/pforge-run.1

include bin/compare_with_cpython
include bin/compare_with_xml
include bin/check-pforge-with-pylint
include bin/autoformat-pforge-source
include bin/measure-construct-performance

# Runners, mainly for source distribution.
include bin/pforge
include bin/pforge-run
include bin/compile-python-for-pforge-linux.sh
include bin/compile-python-for-pforge-mac.sh
include bin/compile-python-for-pforge-windows.cmd

include misc/*.cmd
include misc/pforge-completion.bash
include misc/pforge-completion.zsh
include tests/run-tests

include pforge/plugins/standard/*.yml

# Logo with source
include doc/Logo/Pforge-Logo-Symbol.svg
include doc/Logo/Pforge-Logo-Vertical.svg
include doc/Logo/Pforge-Logo-Horizontal.svg
include doc/images/Pforge-Logo-Symbol.png
include doc/images/Pforge-Logo-Vertical.png
include doc/images/Pforge-Logo-Horizontal.png

recursive-include lib *.py

# Core tests are included along with Pforge itself.
recursive-include tests/basics *.py
recursive-include tests/syntax *.py
recursive-include tests/packages *.py
recursive-include tests/programs *.py
recursive-include tests/programs *.yml
include tests/programs/pkgutil_usage/package/DATA_FILE*.txt
include tests/programs/resource_reader37/some_package/DATA_FILE*.txt
include tests/onefile/external-data/*.txt
recursive-include tests/optimizations *.py
recursive-include tests/standalone *.py
recursive-include tests/onefile *.py
recursive-include tests/reflected *.py
recursive-include tests/type_inference *.py
recursive-include tests/plugins *.py
recursive-include tests/plugins *.yml
include tests/plugins/data_files/data_files_package/*.txt
include tests/plugins/data_files/data_files_package/sub_dir/*.txt

# C templates for code generation.
recursive-include pforge/code_generation/templates_c *.j2

# Report templates
recursive-include pforge/reports *.j2

# Installer backend templates
recursive-include pforge/installer/backends *.nsi
