"""
The CCompileVersion scons file is for version output of the C compiler used with
given flags only. Check out Backend.scons for where the actual compiled binaries
are build.

This is supposed to output compiler related information and then quit. It should
actually compile anything.

"""

# Make pforge package importable from calling installation

import os
import sys
import types

sys.modules["pforge"] = types.ModuleType("pforge")
sys.modules["pforge"].__path__ = [os.environ["PFORGE_PACKAGE_DIR"]]

# We are in the build.build package really.
import pforge.build  # pylint: disable=unused-import

__package__ = "pforge.build"  # pylint: disable=redefined-builtin

# isort:start

from pforge.Tracing import my_print

from .SconsCompilerSettings import (
    createPforgeSconsEnvironment,
    reportCCompiler,
)

# Set up the basic stuff.
env = createPforgeSconsEnvironment(needs_source_dir=False)

if env.no_usable_compiler:
    my_print("Version C compiler: not found.")

    sys.exit(0)


# Report the C compiler used.
reportCCompiler(env, "Version", my_print)

# TODO: Report modes.

sys.exit(0)

