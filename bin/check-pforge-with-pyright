#!/usr/bin/env python3

"""Launcher for pyright checker tool."""

import os
import sys

# Unchanged, running from checkout, use the parent directory, the pforge
# package ought to be there.
sys.path.insert(0, os.path.normpath(os.path.join(os.path.dirname(__file__), "..")))

# isort:start

from pforge.tools.quality.pyright.__main__ import main

sys.exit(main())
