#!/usr/bin/env python
#     Copyright 2026, Kay Hayen, mailto:kay.hayen@gmail.com find license text at end of file


"""Tool to compare XML outputs of two Pforge versions."""

import os
import shutil
import sys
import tempfile

# Unchanged, running from checkout, use the parent directory, the pforge
# package ought be there.
sys.path.insert(0, os.path.normpath(os.path.join(os.path.dirname(__file__), "..")))

# isort:start

from pforge.tools.testing.Common import my_print
from pforge.utils.Diffs import getUnifiedDiff
from pforge.utils.Execution import executeProcess
from pforge.utils.FileOperations import getFileContentByLine

pforge1 = sys.argv[1]
pforge2 = sys.argv[2]
filename = sys.argv[3]

my_print(
    "Comparing output of '%s' using '%s' <-> '%s' ..." % (filename, pforge1, pforge2)
)

temp_dir = tempfile.mkdtemp(prefix="pforge-compare-xml-")

xml_filenames = {}
exit_code = 0

try:
    for label, pforge in (("pforge1", pforge1), ("pforge2", pforge2)):
        xml_filename = os.path.join(temp_dir, "%s.xml" % label)
        xml_filenames[label] = xml_filename

        # Only the optimization result is compared, so stop after code
        # generation and avoid compiling imported modules.
        command = [pforge, "--generate-c-only", "--nofollow-imports"]
        command += [
            option for option in os.getenv("PFORGE_EXTRA_OPTIONS", "").split() if option
        ]
        command += [
            "--xml=%s" % xml_filename,
            "--output-dir=%s" % os.path.join(temp_dir, label),
            filename,
        ]

        process_result = executeProcess(command)

        if process_result.exit_code != 0:
            my_print(
                "Command '%s' failed with exit code %d"
                % (" ".join(command), process_result.exit_code)
            )

            if process_result.stdout:
                my_print(process_result.stdout)

            if process_result.stderr:
                my_print(process_result.stderr)

            exit_code = 1

    if exit_code == 0:
        old_lines = getFileContentByLine(xml_filenames["pforge1"], encoding="utf-8")
        new_lines = getFileContentByLine(xml_filenames["pforge2"], encoding="utf-8")

        diff = list(
            getUnifiedDiff(
                old_lines=old_lines,
                new_lines=new_lines,
                old_filename="%s (%s)" % ("pforge1 " + filename, "xml"),
                new_filename="%s (%s)" % ("pforge2 " + filename, "xml"),
                num_lines=3,
            )
        )

        if diff:
            for line in diff:
                my_print(line, end="\n" if not line.startswith("---") else "")

            exit_code = 1
finally:
    shutil.rmtree(temp_dir, ignore_errors=True)

if exit_code:
    sys.exit("Error, outputs differed.")

my_print("OK, same outputs.")

