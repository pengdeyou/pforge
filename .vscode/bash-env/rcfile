# Source the user's primary .bashrc
if [[ -f $HOME/.bashrc ]]; then
    source $HOME/.bashrc
fi

# Source Pforge completion if available
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -f "$DIR/../../misc/pforge-completion.bash" ]]; then
    source "$DIR/../../misc/pforge-completion.bash"
fi
